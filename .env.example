# ==============================================================================
# Darukaa.Earth Environment Variables Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Darukaa.Earth Biodiversity Intelligence"

# PostgreSQL + pgvector Database Configuration
POSTGRES_DB=darukaa_earth
POSTGRES_USER=darukaa
POSTGRES_PASSWORD=darukaa_earth_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://darukaa:darukaa_earth_secret@localhost:5432/darukaa_earth
DATABASE_SYNC_URL=postgresql+psycopg2://darukaa:darukaa_earth_secret@localhost:5432/darukaa_earth

# Automatic SQLite Fallback (set to true for offline / standalone test mode)
ENABLE_SQLITE_FALLBACK=true
SQLITE_PATH=darukaa_local.db

# Vector Embeddings & RAG
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
TOP_K_RETRIEVAL=6

# Optional LLM API Keys (System operates with deterministic scientific reasoning engine if keys absent)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# External Environmental APIs
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
GBIF_API_URL=https://api.gbif.org/v1/occurrence/search
EXTERNAL_API_TIMEOUT_SECONDS=5

# Frontend
BACKEND_URL=http://localhost:8000
